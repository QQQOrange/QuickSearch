# ============================================================================
#  Quick Search —— 构建产物、依赖、运行时产物
#
#  原则：**只把"能重新生成的东西"挡在外面**。
#
#  ⚠ 实测证据（docs/evidence 截图、tools/probe-out 探针日志）**不入库**：
#  它们是"当时的实测结果"，体积 38MB，且重跑探针就能再生成。
#  需要追溯历史证据时去 `D:\Local AI\git\QuickSearch-evidence-archive`。
# ============================================================================

# ---- Rust / Tauri 构建产物 ----
/target/
**/target/
*.pdb
*.lib

# ---- Node 依赖（体积大、可重装）----
/node_modules/
**/node_modules/
tools/node_modules/

# ---- 运行时临时文件 ----
*.tmp
*.bak
*.log
build-warmup.log
electron-install.log
fetch-icons.log

# ---- 助手工作目录（本项目用它存会话记忆，不属于产品）----
/.workbuddy/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---- 本地配置 / 密钥（绝不能进仓库）----
.env
.env.*
*.secret
config.local.json

# ---- 实测证据（截图 / 探针日志）不入库：体积大且可重跑 ----
docs/evidence/
tools/probe-out/

# 探针脚本会把结果写回 tools/*.txt（历史习惯，脚本里硬编码的路径）。
# 这些也是"重跑就有"的产物，同样不该入库 —— 不然每次跑完探针工作区都变脏。
tools/*.txt

# 探针拍出来的对照图（r83 的圆角同心取证）：同样是"重跑就有"的产物。
# ⚠ 只挡图片与 JSON 结果，**不挡脚本本身** —— tools/bar-radius-*.js
#   是要入库的（它们是这次的验证手段，以后改圆角还能重跑）。
#   v1.5.16：翻译 e2e 的 mock 请求流水是 .jsonl，一并挡掉。
tools/_*.png
tools/_*.json
tools/_*.jsonl

# ---- AI 推理运行时（r80）----
# `onnxruntime.dll` 11.8MB：二进制不该进版本库（每次改动都产生新 blob，
# 历史迅速膨胀，而且它极少变）。构建机上放一份到 vendor/ort/lib/ 即可，
# `build.rs` 会自动拷到产物目录、随发布包分发。放法见 vendor/ort/README.md。
vendor/ort/lib/*.dll
vendor/ort/lib/*.lib

# build artifacts: local target_build dir (used when exe is locked)
/target_build/
**/target_build/

# 手工验证下载时 curl 到仓库根目录的临时文件
# （v1.5.11 发版时 `git add -A` 把 13MB 的 _api.exe 一起提交了，amend 才清掉）
/_*.exe
/_p1
/_p2
/_full
/_part.bin
/_hdr.txt
/_rel_*.json
/_patch*.json
/_asset.json
/_latest.json
/_c.json
/_put*.json
/_f.json
/_remote.md
